[Unit]
Description=SOLIDBENCH CAD workbench
After=network.target

[Service]
Type=simple
User=solidbench
Group=solidbench
WorkingDirectory=/srv/solidbench
Environment=SOLIDBENCH_DATA=/var/lib/solidbench
Environment=QT_QPA_PLATFORM=offscreen
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/solidbench-env/bin/python /srv/solidbench/server.py --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/solidbench

[Install]
WantedBy=multi-user.target
